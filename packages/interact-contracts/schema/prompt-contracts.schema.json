{
  "$defs": {
    "PromptCatalogPage": {
      "additionalProperties": false,
      "description": "One typed, cursor-addressed delta from the prompt catalogue.",
      "properties": {
        "cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cursor"
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/PromptChannelEntry"
          },
          "title": "Entries",
          "type": "array"
        },
        "removed": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PromptKey"
          },
          "title": "Removed",
          "type": "array"
        },
        "server_timestamp": {
          "format": "date-time",
          "title": "Server Timestamp",
          "type": "string"
        }
      },
      "required": [
        "entries",
        "server_timestamp"
      ],
      "title": "PromptCatalogPage",
      "type": "object"
    },
    "PromptChannelEntry": {
      "additionalProperties": false,
      "description": "Compare-and-swap channel pointer to one immutable prompt revision.",
      "properties": {
        "channel": {
          "title": "Channel",
          "type": "string"
        },
        "digest": {
          "title": "Digest",
          "type": "string"
        },
        "key": {
          "$ref": "#/$defs/PromptKey"
        },
        "lock_version": {
          "minimum": 0,
          "title": "Lock Version",
          "type": "integer"
        },
        "revision": {
          "format": "uuid",
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "key",
        "channel",
        "revision",
        "digest",
        "lock_version"
      ],
      "title": "PromptChannelEntry",
      "type": "object"
    },
    "PromptExecutionRef": {
      "additionalProperties": false,
      "description": "Server-verified immutable prompt identity persisted with one execution.",
      "properties": {
        "channel": {
          "title": "Channel",
          "type": "string"
        },
        "digest": {
          "title": "Digest",
          "type": "string"
        },
        "key": {
          "$ref": "#/$defs/PromptKey"
        },
        "revision": {
          "format": "uuid",
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "key",
        "channel",
        "digest",
        "revision"
      ],
      "title": "PromptExecutionRef",
      "type": "object"
    },
    "PromptKey": {
      "additionalProperties": false,
      "description": "Stable prompt identity independent of revisions and publication channels.",
      "properties": {
        "namespace": {
          "title": "Namespace",
          "type": "string"
        },
        "slug": {
          "title": "Slug",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "slug"
      ],
      "title": "PromptKey",
      "type": "object"
    },
    "PromptPublicationRequest": {
      "additionalProperties": false,
      "description": "One complete exact-commit prompt snapshot applied by global cursor CAS.",
      "properties": {
        "entries": {
          "items": {
            "$ref": "#/$defs/PromptSelection"
          },
          "title": "Entries",
          "type": "array"
        },
        "expected_cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Cursor"
        },
        "revisions": {
          "items": {
            "$ref": "#/$defs/PromptRevision"
          },
          "title": "Revisions",
          "type": "array"
        },
        "source_commit": {
          "title": "Source Commit",
          "type": "string"
        }
      },
      "required": [
        "source_commit",
        "entries",
        "revisions"
      ],
      "title": "PromptPublicationRequest",
      "type": "object"
    },
    "PromptRevision": {
      "additionalProperties": false,
      "description": "Immutable prompt content and its verifiable publication provenance.",
      "properties": {
        "content": {
          "title": "Content",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "digest": {
          "title": "Digest",
          "type": "string"
        },
        "key": {
          "$ref": "#/$defs/PromptKey"
        },
        "parent_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Digest"
        },
        "revision": {
          "format": "uuid",
          "title": "Revision",
          "type": "string"
        },
        "source_commit": {
          "title": "Source Commit",
          "type": "string"
        }
      },
      "required": [
        "key",
        "revision",
        "digest",
        "content",
        "source_commit",
        "created_at"
      ],
      "title": "PromptRevision",
      "type": "object"
    },
    "PromptSelection": {
      "additionalProperties": false,
      "description": "Untrusted channel and digest requested for server-backed resolution.",
      "properties": {
        "channel": {
          "title": "Channel",
          "type": "string"
        },
        "digest": {
          "title": "Digest",
          "type": "string"
        },
        "key": {
          "$ref": "#/$defs/PromptKey"
        }
      },
      "required": [
        "key",
        "channel",
        "digest"
      ],
      "title": "PromptSelection",
      "type": "object"
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/PromptKey"
    },
    {
      "$ref": "#/$defs/PromptRevision"
    },
    {
      "$ref": "#/$defs/PromptChannelEntry"
    },
    {
      "$ref": "#/$defs/PromptCatalogPage"
    },
    {
      "$ref": "#/$defs/PromptSelection"
    },
    {
      "$ref": "#/$defs/PromptExecutionRef"
    },
    {
      "$ref": "#/$defs/PromptPublicationRequest"
    }
  ]
}
